{
  "name": "sabino-contact-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "test": "node --test test/*.test.mjs",
    "check": "wrangler deploy --dry-run",
    "db:migrate:local": "wrangler d1 migrations apply CONTACTS --local",
    "db:migrate:remote": "wrangler d1 migrations apply CONTACTS --remote",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.125.0"
  }
}
