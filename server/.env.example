# Copy to a private .env.local. Never commit actual keys.
# Purchases remain disabled until deliberately configured and enabled.
VERSO_PAYMENTS_ENABLED=false
VERSO_PUBLIC_ORIGIN=http://localhost:4174
# Production container defaults already point to /data. Mount it as a persistent volume.
# NODE_ENV=production
# VERSO_PUBLIC_ORIGIN=https://sabino.pro
# VERSO_ALLOWED_ORIGINS=https://sabino.github.io
# VERSO_WORLD_STORAGE=/data/worlds
# VERSO_PAYMENT_STORAGE=/data/payments
# Only enable with an isolated container behind exactly this many controlled proxies.
VERSO_TRUST_PROXY_HOPS=0
VERSO_MAX_ROOMS=64
VERSO_MAX_CONNECTIONS=512
VERSO_MAX_CONNECTIONS_PER_IP=32
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_AURORA_MANTLE=
STRIPE_PRICE_PROMETHEAN_GOLD=
STRIPE_PRICE_SALLAS_SILVER=
